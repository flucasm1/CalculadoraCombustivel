<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculadoraCombustivel.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />
            
            <Label Text="Preço do etanol:" />
            <Entry x:Name="txt_etanol" Placeholder="Digite o preço do etanol em R$"/>   

            <Label Text="Preço da gasolina:" />
            <Entry x:Name="txt_gasolina" Placeholder="Digite o preço da gasolina em R$"/>
            
            <Button Text="Qual compensa mais?" Clicked="Button_Clicked" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
